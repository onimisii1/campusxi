# Copy to .env and fill in. Never commit .env.
# Supabase: Project Settings -> Database -> Connection string (use the pooler URI for production).
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Supabase: Project Settings -> API -> Project URL. Tokens are verified against its JWKS.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret; leave empty otherwise.
SUPABASE_JWT_SECRET=
# Supabase: Project Settings -> API Keys -> service_role / secret key. SERVER ONLY: used to delete
# a player's sign-in when they delete their account. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Match-result bets need a sports-betting licence; keep false until it is held.
RESULT_BETS_ENABLED=false

# ---- Real money (test mode first: use the sk_test_ / FLWSECK_TEST- keys) ----
PAID_PLAY_ENABLED=false
# Paystack: Dashboard -> Settings -> API Keys & Webhooks -> Test Secret Key
PAYSTACK_SECRET_KEY=
# Flutterwave (fallback): Dashboard -> Settings -> API Keys -> Test Secret Key
FLUTTERWAVE_SECRET_KEY=
# Flutterwave: Settings -> Webhooks -> "Secret hash" (any long random string you choose there)
FLUTTERWAVE_WEBHOOK_HASH=
# Where checkout sends players back to (the web app's address)
PUBLIC_APP_URL=http://localhost:5180
# ID checks: "stub" for testing; set a long random pepper in production
KYC_PROVIDER=stub
KYC_PEPPER=
# Background jobs (refunds at kick-off, payouts, reconciliation) on exactly one API instance
JOBS_ENABLED=false
